# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# ------------------------------------------------------------ 虚拟环境
.venv/
venv/
env/
ENV/

# --------------------------------------------- 编辑器 / 系统的本地配置与临时文件
.vscode/
.idea/
.vs/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ------------------------------------------------------------ 智能体工作约定
# 本机使用的协作说明，不入库
/AGENTS.md

# --------------------------------------------------------- 构建 / 运行期产物
build/
dist/
_build/
# PyInstaller 等打包工具的本地构建配置
*.spec
# 可复现的发布配置需要纳入版本控制
!packaging/InVerusEditor.spec
# 打包好的发布产物（改用 GitHub Release 等渠道分发，不入库）
release/
# 运行日志（超过上限自动截断）
*.log

# -------------------------------------------------------- 临时 / 诊断工作区
# 调试脚本、诊断探针、截图、日志、基准数据一律放这里，不入库、不参与打包
_temp/

# ------------------------------------------- 测试与开发辅助脚本（仅本机，不入库）
tests/
tools/

# ------------------------------------------------------------------ 用户内容
# 编辑器设置：跟着程序放在项目 / exe 所在文件夹，属于本机使用者，不入库
/settings.json
# 谱面目录整体视为用户内容，不入库；示例谱面用
# `python run_editor.py --make-demo` 随时重新生成。
# 其中的音频、临时测试谱面等自然也一并忽略。
charts/
