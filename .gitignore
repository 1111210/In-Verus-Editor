# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# ------------------------------------------------------------ 虚拟环境
.venv/
venv/
env/
ENV/

# --------------------------------------------- 编辑器 / 系统的本地配置与临时文件
.vscode/
.idea/
.vs/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# --------------------------------------------------------- 构建 / 运行期产物
build/
dist/
_build/
# PyInstaller 等打包工具的本地构建配置
*.spec
# 可复现的发布配置需要纳入版本控制
!packaging/InVerusEditor.spec
# 打包好的发布产物（改用 GitHub Release 等渠道分发，不入库）
release/
# 运行日志（超过上限自动截断）
*.log

# --------------------------------------------------------- 测试 / 诊断产物
# 音频等自检日志
_diag/
# 测试与开发辅助脚本：本地保留、不入库
tests/
tools/
# 本地草稿
scratch/

# ------------------------------------------------------------- 用户内容
# 编辑器设置：跟着程序放在项目 / exe 所在文件夹，属于本机使用者，不入库
/settings.json
# 谱面目录整体视为用户内容，不入库；示例谱面用
# `python run_editor.py --make-demo` 随时重新生成。
# 其中的音频、临时测试谱面等自然也一并忽略。
charts/
